{
  "manifest_version": 3,
  "name": "KEXP Now Playing",
  "version": "2.0",
  "description": "Display what's currently playing on KEXP.org radio stream and save tracks to Spotify",
  "permissions": [
    "identity",
    "storage"
  ],
  "host_permissions": [
    "https://api.kexp.org/*",
    "https://accounts.spotify.com/*",
    "https://api.spotify.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
